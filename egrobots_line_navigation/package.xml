<?xml version="1.0"?>
<package format="3">
  <name>egrobots_line_navigation</name>
  <version>0.0.0</version>
  <description>Straight-line A-to-B navigation using only a 2D LiDAR and an IMU.</description>
  <maintainer email="shwertel@todo.todo">shwertel</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>egrobots_line_interfaces</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_tools</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
