<?xml version="1.0"?>
<!-- WARNING about punctuation in this file. Two separate traps live here.

     ONE. An XML comment may not contain a double hyphen. Not anywhere, not
     even in prose. The parser rejects the whole document and xacro reports
     only "not well-formed (invalid token)" with a line and column.

     TWO. gazebo_ros2_control hands the whole expanded URDF to the controller
     manager as a command line parameter override, and rcl parses that value
     as YAML. A colon followed by a space, or a colon at the end of a line,
     reads as a YAML mapping key and the parse fails. The controller manager
     then never starts and both spawners hang forever waiting on
     /controller_manager/list_controllers. It is reported as "parser error
     Couldn't parse parameter override rule", and the message is truncated
     long before the offending text, so it points nowhere near the real line.

     Comments count for both. To check, neither of these may print anything.
         grep -nE ':(\s|$)' egrobots_rover.urdf.xacro
         grep -nP '(?<!<!)[-][-](?!>)' egrobots_rover.urdf.xacro
-->
<robot name="egrobots_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Which sensor the rover carries. "depth" is the front RGB-D (default),
       "lidar" (the original 360 deg planar scanner) or "both", which is only
       useful for comparing the two against each other. -->
  <xacro:arg name="sensor_suite" default="depth"/>
  <xacro:property name="suite" value="$(arg sensor_suite)"/>
  <xacro:property name="use_lidar" value="${suite == 'lidar' or suite == 'both'}"/>
  <xacro:property name="use_depth" value="${suite == 'depth' or suite == 'both'}"/>

  <!-- Camera placement, in one place so the converter node and the URDF
       cannot disagree. base_link rides 0.25 m above the ground, so a camera
       at base_link z = 0.45 is 0.70 m up. -->
  <xacro:property name="cam_x" value="0.30"/>
  <xacro:property name="cam_z" value="0.45"/>
  <xacro:property name="cam_pitch" value="0.31416"/>   <!-- 18 deg nose-down -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.5 0.35"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.5 0.35"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.5"/>
    </inertial>
  </link>
  <link name="wheel_front_left">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.2 0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="wheel_front_right">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.2 -0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_left">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.2 0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_right">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.2 -0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="mast">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.6"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.6"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0 0 0.475" rpy="0 0 0"/>
  </joint>
  <link name="sensor_mount">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="sensor_mount_joint" type="fixed">
    <parent link="mast"/>
    <child link="sensor_mount"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- IMU, mounted on the chassis. Its yaw measurement is independent of the
       wheels, so it is unaffected by the sideways scrub that corrupts wheel
       odometry on a skid-steer platform. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ==================  FRONT RGB-D DEPTH CAMERA  ==================
       A short arm carries the camera forward off the mast to the front of
       the rover, where it looks down the lane and slightly down at the floor.

       Four frames, and the difference between them matters.
         camera_arm           - the bracket, just something to see in rviz
         camera_link          - the camera body. x forward, y left, z up,
                                PITCHED 18 deg nose-down.
         camera_link_optical  - the same point in optical convention
                                (z forward, x right, y down). The depth image
                                and its camera_info are stamped with this.
         camera_scan_frame    - the camera's position but LEVEL. The scan the
                                converter synthesises is a horizontal slice,
                                so it must not inherit the camera's pitch or
                                amcl would read every beam as tilted. -->
  <link name="camera_arm">
    <visual>
      <geometry>
        <box size="0.30 0.04 0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
    </inertial>
  </link>

  <joint name="camera_arm_joint" type="fixed">
    <parent link="mast"/>
    <child link="camera_arm"/>
    <!-- mast origin is base_link z=0.475, so -0.025 puts the arm at z=0.45 -->
    <origin xyz="0.15 0 -0.025" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.07"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_arm"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 0" rpy="0 ${cam_pitch} 0"/>
  </joint>

  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_scan_frame"/>

  <joint name="camera_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_scan_frame"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="wheel_front_left">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="wheel_front_right">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="wheel_rear_left">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="wheel_rear_right">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <gazebo reference="mast">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="sensor_mount">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <imu>
        <angular_velocity>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <!-- Ground truth, for scoring the estimator only. Not an input to the EKF,
       the controller or the navigator, and absent on real hardware. -->
  <gazebo>
    <plugin name="ground_truth_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>20</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
    </plugin>
  </gazebo>
  <!-- The original 360 deg planar LiDAR. Kept, but off by default, so the two
       sensors can be run against each other on the same world and the same
       mission rather than argued about. -->
  <xacro:if value="${use_lidar}">
    <gazebo reference="sensor_mount">
      <material>Gazebo/Black</material>
      <sensor name="lidar_sensor" type="ray">
        <pose>0 0 0.045 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.015</resolution>
          </range>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>sensor_mount</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Front RGB-D depth camera, Intel RealSense D435 class.

       87 deg horizontal FOV; at 424x240 the aspect gives 56.5 deg vertical.
       Pitched 18 deg down from 0.70 m, so the optical axis meets the floor
       2.15 m ahead and the rows at +/-0.80 m come into view 0.84 m ahead.

       What this buys over the LiDAR is height. A plane at 0.77 m flies straight
       over a toolbox on the floor. What it costs is everything past 43.5 deg
       off the nose. There is no side or rear vision at all. -->
  <xacro:if value="${use_depth}">
    <gazebo reference="camera_link">
      <material>Gazebo/Blue</material>
      <sensor name="depth_camera" type="depth">
        <always_on>true</always_on>
        <!-- 10 Hz, not 15. A real D435 will do 30, but every frame costs a
             depth render in Gazebo, a deprojection in depth_to_scan_node and
             a redraw in rviz. At 15 Hz rviz stopped responding during
             headland turns, where the camera sweeps across the whole
             greenhouse at once. 10 Hz is also what the LiDAR ran at. -->
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <camera name="depth_camera">
          <horizontal_fov>1.51844</horizontal_fov>
          <image>
            <width>424</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>6.0</far>
          </clip>
          <!-- Real depth noise grows with the square of range; Gazebo only
               offers a constant sigma, so this is the near-field figure and
               the far field comes out optimistic. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link_optical</frame_name>
          <hack_baseline>0.07</hack_baseline>
          <min_depth>0.3</min_depth>
          <max_depth>6.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <ros2_control name="EgrobotsRoverSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wheel_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find egrobots_line_navigation)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
