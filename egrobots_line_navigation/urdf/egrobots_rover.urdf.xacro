<?xml version="1.0"?>
<robot name="egrobots_rover">
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.5 0.35"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.5 0.35"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.5"/>
    </inertial>
  </link>
  <link name="wheel_front_left">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.2 0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="wheel_front_right">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.2 -0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_left">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.2 0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_right">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Solid cylinder r=0.15, L=0.15, m=1.0, spinning about Y (the joint axis).
           Axial term    m*r^2/2           = 0.01125  (iyy)
           Transverse    m*(3r^2 + L^2)/12 = 0.0075   (ixx, izz)
           Previously 0.01 on all three axes, which describes a sphere, not a wheel. -->
      <inertia ixx="0.0075" ixy="0.0" ixz="0.0" iyy="0.01125" iyz="0.0" izz="0.0075"/>
    </inertial>
  </link>

  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.2 -0.28 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="mast">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.6"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.6"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0 0 0.475" rpy="0 0 0"/>
  </joint>
/  <link name="sensor_mount">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="sensor_mount_joint" type="fixed">
    <parent link="mast"/>
    <child link="sensor_mount"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- IMU, mounted on the chassis. Its yaw measurement is independent of the
       wheels, so it is unaffected by the sideways scrub that corrupts wheel
       odometry on a skid-steer platform. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="wheel_front_left">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="wheel_front_right">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="wheel_rear_left">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="wheel_rear_right">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <gazebo reference="mast">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="sensor_mount">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <imu>
        <angular_velocity>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <!-- Ground truth, for scoring the estimator only. Not an input to the EKF,
       the controller or the navigator, and absent on real hardware. -->
  <gazebo>
    <plugin name="ground_truth_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>20</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="sensor_mount">
    <material>Gazebo/Black</material>
    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0.045 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.015</resolution>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_mount</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <ros2_control name="EgrobotsRoverSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wheel_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find egrobots_line_navigation)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
