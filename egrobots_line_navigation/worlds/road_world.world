          <material><ambient>0.25 0.35 0.6 1</ambient><diffuse>0.25 0.35 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="car_left_03">
      <static>true</static>
      <pose>14.75 3.90 0.75 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>4.5 1.8 1.5</size></box></geometry></collision>
