# Travel the straight line from Point A to Point B in walk/pause iterations,
# avoiding obstacles and returning to the same line afterwards.
#
# The line is a geometric object, not a sequence of waypoints: progress is
# measured along it and error is measured perpendicular to it. That is what
# makes "return to the line the robot was following" (R7) well defined — the
# controller nulls cross-track error, so recovering from an avoidance detour is
# the same operation as driving straight in the first place.

# --- Goal (R1, R2) -----------------------------------------------------------
geometry_msgs/Point start        # Point A
geometry_msgs/Point goal         # Point B
float64 tolerance                # arrival radius; <= 0 uses the node default
---
# --- Result (R9) -------------------------------------------------------------
bool success
string message
float64 final_distance_error     # how far from B it actually stopped
float64 max_cross_track_error    # worst deviation from the line over the run
geometry_msgs/Point final_position
---
# --- Feedback (R3, R7) -------------------------------------------------------
float64 distance_to_goal
float64 distance_along_line      # progress from A toward B
float64 cross_track_error        # signed perpendicular distance from the line
geometry_msgs/Point current_position
string state                     # WALKING | PAUSED | AVOIDING | RETURNING
int32 iteration                  # which walk/pause cycle we are in
